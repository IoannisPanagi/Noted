# JWT Service
# Secret must be 256 bits long
# Expiry is 12 hours in milliseconds
JWT_SECRET=SECRET!!
JWT_EXPIRY=43200000

# On which port should the server run on?
PORT=3000

# Password fingerprint
# Seperate secret from JWT_SECRET, avoid copying;
# Changing it revokes all active tokens, meaning everybody gets logged out.
PWF_SECRET=ANOTHER_SECRET!!

# Where the SQLite database file lives
DB_FILE_NAME=noted.db

# Browser origins allowed to call the API with credentials (comma separated).
# Leave empty for same-origin or reverse-proxied deployments.
CORS_ORIGINS=http://localhost:5173

# How much the server says: silent, fatal, error, warn, info (default), debug, trace
LOG_LEVEL=info
