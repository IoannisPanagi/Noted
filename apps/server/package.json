{
	"name": "server",
	"version": "1.0 (Solaris)",
	"private": true,
	"scripts": {
		"build": "nest build",
		"format": "biome format --fix",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"dev": "nest start --env-file .env --watch",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"lint": "biome lint --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json"
	},
	"dependencies": {
		"@nestjs/common": "^11.0.1",
		"@nestjs/core": "^11.0.1",
		"@nestjs/jwt": "^11.0.2",
		"@nestjs/platform-express": "^11.0.1",
		"@nestjs/platform-socket.io": "^12.0.1",
		"@nestjs/swagger": "^11.4.7",
		"@nestjs/websockets": "^12.0.1",
		"bcrypt": "^6.0.0",
		"better-sqlite3": "^12.11.1",
		"cookie": "^2.0.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^17.4.2",
		"drizzle-orm": "1.0.0-rc.4",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.16.2",
		"@types/express": "^5.0.0",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.10.7",
		"@types/supertest": "^6.0.2",
		"drizzle-kit": "1.0.0-rc.4",
		"globals": "^16.0.0",
		"jest": "^30.0.0",
		"prettier": "^3.4.2",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.13",
		"typescript": "^5.7.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node",
		"setupFiles": [
			"<rootDir>/../test/jest-setup-env.ts"
		],
		"moduleNameMapper": {
			"^@constants$": "<rootDir>/constants.ts",
			"^@schema$": "<rootDir>/drizzle/index.ts",
			"^@noted/types$": "<rootDir>/types/index.d.ts",
			"^@drizzle/(.*)$": "<rootDir>/drizzle/$1",
			"^@noted/(.*)$": "<rootDir>/$1"
		}
	}
}
