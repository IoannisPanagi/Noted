{
	"root": false,
	"extends": "//",
	"linter": {
		"domains": {
			"drizzle": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noConsole": "off"
			}
		}
	},
	"javascript": {
		"formatter": { "trailingCommas": "all", "semicolons": "always" },
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	}
}
