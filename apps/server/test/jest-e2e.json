{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": ".",
	"testEnvironment": "node",
	"testRegex": ".e2e-spec.ts$",
	"transform": {
		"^.+\\.(t|j)s$": "ts-jest"
	},
	"setupFiles": ["<rootDir>/jest-setup-e2e.ts"],
	"moduleNameMapper": {
		"^@constants$": "<rootDir>/../src/constants.ts",
		"^@schema$": "<rootDir>/../src/drizzle/index.ts",
		"^@noted/types$": "<rootDir>/../src/types/index.d.ts",
		"^@drizzle/(.*)$": "<rootDir>/../src/drizzle/$1",
		"^@noted/(.*)$": "<rootDir>/../src/$1"
	},
	"globalSetup": "<rootDir>/jest-global-setup.ts",
	"globalTeardown": "<rootDir>/jest-global-teardown.ts"
}
