{
	"root": true,
	"$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!**/dist",
			"!!**/build",
			"!!**/converage",
			"!!**/node_modules",
			"!!**/.svelte-kit"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"turborepo": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"style": {
				"useImportType": "off"
			},
			"correctness": { "noUnusedImports": "warn" }
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"json": { "formatter": { "trailingCommas": "none" } },
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
